DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

PORT_GATEWAY=8000
PORT_IDENTITY=8001
PORT_PRODUCT=8002
PORT_ORDER=8003
PORT_NOTIFICATION=8004
PORT_CHAT=8005

IDENTITY_SERVICE_URL=http://localhost:8001
PRODUCT_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004
CHAT_SERVICE_URL=http://localhost:8005

JWT_SECRET=ecommerce_identity_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Google Gemini AI Configuration (Dành cho Live Chat & Trợ lý thông minh NovaBot)
# Có thể truyền nhiều key phân cách bằng dấu phẩy để hệ thống tự động xoay tua / random tránh rate limit
GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-flash-lite-latest"
AI_CHATBOT_MODEL="gemini-flash-lite-latest"

# SePay Payment Gateway Configuration (VietQR tự động - cấu hình sẵn trong env)
SEPAY_API_URL=https://my.sepay.vn
SEPAY_API_KEY=your_sepay_api_key
SEPAY_ACCOUNT_NUMBER=your_bank_account_number
SEPAY_BANK_NAME=MBBank
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NAME="NGUYEN VAN A"
SEPAY_WEBHOOK_TOKEN=your_sepay_webhook_secret_key

# GHN (Giao Hàng Nhanh) Configuration
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=your_ghn_api_token
GHN_SHOP_ID=your_ghn_shop_id
GHN_FROM_NAME="NovaShop Logistics"
GHN_FROM_PHONE="0987654321"
GHN_FROM_ADDRESS="Số 123 Đường Cầu Giấy"
GHN_FROM_DISTRICT_ID=1442
GHN_FROM_WARD_CODE=20101
GHN_RETURN_PHONE="0987654321"
GHN_RETURN_ADDRESS="Số 123 Đường Cầu Giấy, Phường Dịch Vọng Hậu, Quận Cầu Giấy, Hà Nội"
GHN_TEST_MODE=false
GHN_TRACKING_URL=https://tracking.ghn.vn/?order_code=

# MoMo Payment Gateway Configuration
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_VERIFY_SSL=false
MOMO_REQUEST_TYPE=payWithATM
MOMO_REDIRECT_URL=http://localhost:8000/api/orders/payment/momo/callback
MOMO_IPN_URL=http://localhost:8000/api/orders/payment/momo/ipn

# Mail SMTP Configuration (Gmail App Password or Custom SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="NovaShop"


